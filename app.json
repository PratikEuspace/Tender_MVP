{
  "expo": {
    "name": "Ward Vikas",
    "slug": "Tender_Mvp",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tendermvp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/ios-icon.png",
      "bundleIdentifier": "com.euspace.wardvikas",
      "buildNumber": "7",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow Ward Vikas to access your photos to upload documents."
      }
    },
    "android": {
      "versionCode": 5,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground3.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.euspace.wardvikas",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#062E52",
          "image": "./assets/images/splash-native-fill.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-sqlite",
      "expo-document-picker",
      "expo-file-system",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Ward Vikas to access your photos to upload documents."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-image",
      "expo-localization",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "777c7a6a-2e88-4aec-a689-bca021b5647d"
      }
    },
    "owner": "euspacetech-2"
  }
}
